{
    "name": "ages/edi-documents",
    "description": "EDI document generator (ORION XML DESADV + INVOIC) with SSCC code and label generator",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "mpdf/mpdf": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ages\\EdiDocuments\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse"
    }
}
